    {
      "parameters": {
        "jsCode": "// Handle both message and callback_query\nlet chatId = null;\nlet username = null;\nlet firstName = null;\nlet lastName = null;\nlet isPremium = false;\nlet languageCode = 'en';\n\n// Get data from body\nconst body = $json.body;\n\n// Check if it's a callback_query (button press)\nif (body.callback_query) {\n  const callback = body.callback_query;\n  const message = callback.message;\n  chatId = message.chat.id;\n  username = message.chat.username || null;\n  firstName = message.chat.first_name || '';\n  lastName = message.chat.last_name || '';\n  isPremium = callback.from?.is_premium || false;\n  languageCode = callback.from?.language_code || 'en';\n}\n// Check if it's a regular message\nelse if (body.message) {\n  const message = body.message;\n  chatId = message.chat.id;\n  username = message.chat.username || null;\n  firstName = message.chat.first_name || '';\n  lastName = message.chat.last_name || '';\n  isPremium = message.from?.is_premium || false;\n  languageCode = message.from?.language_code || 'en';\n}\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    username: username,\n    first_name: firstName,\n    last_name: lastName,\n    is_premium: isPremium,\n    language_code: languageCode\n  }\n}];"
      },
