    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  p.id,\n  p.name,\n  COUNT(pt.id) AS tracks_count\nFROM pocketsound_playlists p\nLEFT JOIN pocketsound_playlist_tracks pt ON pt.playlist_id = p.id\nWHERE p.user_id = {{ $('Check user in DB').first().json.id }}\nGROUP BY p.id, p.name\nORDER BY p.created_at DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        256,
        176
      ],
      "id": "23c3495f-a9c0-4642-8980-28c74bedc011",
      "name": "Get user playlists",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "WIHxOzYOOSEjd0yr",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const playlists = $input.all().filter(p => p.json.id !== undefined && p.json.id !== null);\nconst chatId = $('Parse /myplaylist command').first().json.chat_id;\n\nif (playlists.length === 0) {\n  return [{\n    json: {\n      chat_id: chatId,\n      empty: true,\n      photo: 'https://silver-perfect-barracuda-186.mypinata.cloud/ipfs/bafkreidjuficdk5vzzdga5xua2rjj657ka276jft4m4ootwag7227bxtny',\n      caption: '📂 No Playlists Found\\n\\nPlaylists help you organize your music collection. You can:\\n• Create up to 3 playlists (33 tracks each)\\n• Add any track from search results\\n• Play all tracks in order\\n\\nClick ➕ Create Playlist to get started!\\n\\n@PocketSound_bot',\n      reply_markup: {\n        inline_keyboard: [\n          [{ text: '➕ Create Playlist', callback_data: 'Create' }],\n          [{ text: '🔙 Back', callback_data: '/back' }]\n        ]\n      }\n    }\n  }];\n}\n\nconst inline_keyboard = playlists.map(playlist => ([\n  {\n    text: `🎵 ${playlist.json.name} (${playlist.json.tracks_count}/33)`,\n    callback_data: `playlist_view|${playlist.json.id}`\n  }\n]));\n\ninline_keyboard.push([{ text: '➕ Create Playlist', callback_data: 'Create' }]);\ninline_keyboard.push([{ text: '✏️ Edit Playlist', callback_data: '/edit|' }]);\ninline_keyboard.push([{ text: '🔙 Back', callback_data: '/back' }]);\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    empty: false,\n    total_playlists: playlists.length,\n    photo: 'https://silver-perfect-barracuda-186.mypinata.cloud/ipfs/bafkreidjuficdk5vzzdga5xua2rjj657ka276jft4m4ootwag7227bxtny',\n    caption: `📂 Your Playlists (${playlists.length}/3)\\n\\nSelect a playlist to view tracks or create a new one!\\n\\n@PocketSound_bot`,\n    reply_markup: { inline_keyboard }\n  }\n}];"
      },
