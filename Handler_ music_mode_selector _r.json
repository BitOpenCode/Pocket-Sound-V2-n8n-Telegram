    {
      "parameters": {
        "jsCode": "const chatId = $('Parse toggle callback').first().json.chat_id;\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: \"PRO Music Mode is currently ACTIVE\\n\\nIn this mode, you can find almost any music files.\\n\\nIf you press the TG Mode button, this mode will be deactivated and you will search only within Telegram.\\n\\nWhat do you want to do?\",\n    reply_markup: {\n      inline_keyboard: [\n        [{ text: \"🎶 Switch to TG Mode\", callback_data: \"/deactivate\" }],\n        [{ text: \"🔙 Back\", callback_data: \"/back\" }]\n      ]\n    }\n  }\n}];"
