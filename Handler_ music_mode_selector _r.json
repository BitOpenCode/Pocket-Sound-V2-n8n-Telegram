    {
      "parameters": {
        "jsCode": "const input = $json;\n\nlet chatId, messageId, username, firstName, lastName, isPremium, languageCode, callbackData;\n\nif (input.body && input.body.callback_query) {\n  const callback = input.body.callback_query;\n  const message = callback.message;\n  chatId = message.chat.id;\n  messageId = message.message_id;\n  const from = callback.from;\n  username = from.username || null;\n  firstName = from.first_name || '';\n  lastName = from.last_name || '';\n  isPremium = from.is_premium || false;\n  languageCode = from.language_code || 'en';\n  callbackData = callback.data || '';\n} else if (input.callback_query) {\n  const callback = input.callback_query;\n  const message = callback.message;\n  chatId = message.chat.id;\n  messageId = message.message_id;\n  const from = callback.from;\n  username = from.username || null;\n  firstName = from.first_name || '';\n  lastName = from.last_name || '';\n  isPremium = from.is_premium || false;\n  languageCode = from.language_code || 'en';\n  callbackData = callback.data || '';\n} else if (input.tg_id) {\n  // Данные пользователя из БД\n  chatId = input.tg_id;\n  messageId = null;\n  username = input.tg_username || null;\n  firstName = input.tg_first_name || '';\n  lastName = input.tg_last_name || '';\n  isPremium = input.premium || false;\n  languageCode = input.language_code || 'en';\n  callbackData = null;\n} else {\n  throw new Error('Invalid input: cannot determine chat_id');\n}\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    message_id: messageId,\n    username: username,\n    first_name: firstName,\n    last_name: lastName,\n    is_premium: isPremium,\n    language_code: languageCode,\n    callback_data: callbackData\n  }\n}];"
      },
