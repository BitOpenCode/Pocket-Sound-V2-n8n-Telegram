    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(p.id)::INTEGER AS current_playlists, (COALESCE(ul.max_playlists, 3) + COALESCE(ul.extra_playlists_purchased, 0))::INTEGER AS max_allowed FROM pocketsound_users u LEFT JOIN pocketsound_playlists p ON p.user_id = u.id LEFT JOIN pocketsound_user_limits ul ON ul.user_id = u.id WHERE u.id = {{ $('Check user in DB').first().json.id }} GROUP BY u.id, ul.max_playlists, ul.extra_playlists_purchased;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
