    {
      "parameters": {
        "jsCode": "const callbackData = $('Parse callback').item.json;\nconst userData = $('Check user in DB').item.json;\n\nconst parts = callbackData.callback_data.split('|');\n\n\nif (parts.length === 2) {\n\n  return [{\n    json: {\n      playlist_id: null,\n      file_id: Number(parts[1]),\n      need_find_file: true,\n      chat_id: callbackData.chat_id,\n      message_id: callbackData.message_id,\n      username: callbackData.username,\n      first_name: callbackData.first_name,\n      user_id: userData.id  \n    }\n  }];\n}\n\nif (parts.length === 3) {\n\n  return [{\n    json: {\n      playlist_id: Number(parts[1]),\n      file_id: Number(parts[2]),\n      need_find_file: false,\n      chat_id: callbackData.chat_id,\n      message_id: callbackData.message_id,\n      username: callbackData.username,\n      first_name: callbackData.first_name,\n      user_id: userData.id  \n    }\n  }];\n}\n\nreturn [{\n  json: {\n    playlist_id: null,\n    file_id: null,\n    need_find_file: false,\n    error: true,\n    chat_id: callbackData.chat_id,\n    message_id: callbackData.message_id,\n    user_id: userData.id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
