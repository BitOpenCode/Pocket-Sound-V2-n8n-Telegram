    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  p.id,\n  p.name,\n  COUNT(pt.id)::INTEGER AS tracks_count\nFROM pocketsound_playlists p\nLEFT JOIN pocketsound_playlist_tracks pt ON pt.playlist_id = p.id\nWHERE p.user_id = {{ $('Check user in DB').item.json.id }}\nGROUP BY p.id, p.name\nORDER BY p.created_at DESC;",
        "options": {}
      },
