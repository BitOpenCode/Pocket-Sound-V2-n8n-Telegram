    {
      "parameters": {
        "jsCode": "const playlists = $input.all();\nconst fileId = $('Parse Playlist Add Callback').first().json.file_id;\nconst chatId = $('Parse Playlist Add Callback').first().json.chat_id; \n\nconst inline_keyboard = playlists.map(playlist => ([\n  {\n    text: `🎵 ${playlist.json.name} (${playlist.json.tracks_count}/33)`,\n    callback_data: `playlist_add|${playlist.json.id}|${fileId}`\n  }\n]));\n\ninline_keyboard.push([\n  {\n    text: '❌ Cancel',\n    callback_data: '/back'\n  }\n]);\n\nreturn [{\n  json: {\n    chat_id: chatId, \n    text: `📂 Choose a playlist:\\n\\n@PocketSound_bot`,\n    parse_mode: 'HTML',\n    reply_markup: { inline_keyboard }\n  }\n}];"
      },
