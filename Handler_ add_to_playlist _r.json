        "jsCode": "const fileId = $('Parse Playlist Add Callback').first().json.file_id;\nconst chatId = $('Parse Playlist Add Callback').first().json.chat_id;\n\nconst inline_keyboard = [\n  [\n    {\n      text: '➕ Create Playlist',\n      callback_data: 'Create'\n    }\n  ],\n  [\n    {\n      text: '❌ Cancel',\n      callback_data: '/back'\n    }\n  ]\n];\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: `📂 You have no playlists yet. Create Playlist!\\n\\n@PocketSound_bot`,\n    parse_mode: 'HTML',\n    reply_markup: { inline_keyboard }\n  }\n}];"
