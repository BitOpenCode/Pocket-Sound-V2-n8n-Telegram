    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT f.id, f.title, f.artist, f.tg_chat_id, f.message_id, pt.position FROM pocketsound_playlist_tracks pt JOIN pocketsound_files f ON f.id = pt.file_id WHERE pt.playlist_id = {{ $('Parse playlist_view callback').first().json.playlist_id }} ORDER BY pt.position ASC;",
        "options": {}
      },
