    {
      "parameters": {
        "jsCode": "const tracks = $input.all();\nconst playlistName = $('Get playlist name').first().json.name;\nconst playlistId = $('Parse playlist_view callback').first().json.playlist_id;\nconst totalTracks = tracks.length;\nconst chatId = $('Parse playlist_view callback').first().json.chat_id;\n\nif (totalTracks === 0) {\n  return [{\n    json: {\n      chat_id: chatId,\n      text: `📂 Playlist: <b>${playlistName}</b>\\n\\n❌ Your playlist is empty.\\n\\nSend any track to the bot or use search to find music.\\nAfter sending/searching, click \"➕ Add to Playlist\" button.\\n\\n@PocketSoundbot`,\n      parse_mode: 'HTML',\n      reply_markup: {\n        inline_keyboard: [\n          [{ text: '🔙 Back to Playlists', callback_data: '/myplaylist' }]\n        ]\n      }\n    }\n  }];\n}\n\nconst validTracks = [];\nfor (const item of tracks) {\n  const track = item.json;\n  if (track && track.id) {\n    const artist = track.artist && String(track.artist).trim() !== '' ? String(track.artist).trim() : 'Unknown artist';\n    const title = track.title && String(track.title).trim() !== '' ? String(track.title).trim() : 'Unknown title';\n    validTracks.push({\n      id: track.id,\n      artist: artist,\n      title: title\n    });\n  }\n}\n\nif (validTracks.length === 0) {\n  return [{\n    json: {\n      chat_id: chatId,\n      text: `📂 Playlist: <b>${playlistName}</b>\\n\\n❌ No tracks found in this playlist. Add tracks to your playlist.\\n\\n@PocketSoundbot`,\n      parse_mode: 'HTML',\n      reply_markup: {\n        inline_keyboard: [\n          [{ text: '🔙 Back to Playlists', callback_data: '/myplaylist' }]\n        ]\n      }\n    }\n  }];\n}\n\nconst firstTenTracks = validTracks.slice(0, 10);\nconst inline_keyboard = firstTenTracks.map(track => ([\n  {\n    text: `🎵 ${track.artist} - ${track.title}`,\n    callback_data: `get|${track.id}`\n  }\n]));\n\nif (totalTracks > 10) {\n  inline_keyboard.push([\n    {\n      text: `▶️ More… (10/${totalTracks})`,\n      callback_data: `playlist_more|${playlistId}|10`\n    }\n  ]);\n}\n\ninline_keyboard.push([\n  {\n    text: `📤 Send All Tracks (${totalTracks})`,\n    callback_data: `playlist_send_all|${playlistId}`\n  }\n]);\n\ninline_keyboard.push([\n  {\n    text: '✏️ Edit Playlist',\n    callback_data: `/edit|playlist|${playlistId}`\n  }\n]);\n\ninline_keyboard.push([\n  {\n    text: '🔙 Back to Playlists',\n    callback_data: '/myplaylist'\n  }\n]);\n\nconst messageText = `📂 Playlist: <b>${playlistName}</b>\\n🎵 Total tracks: ${totalTracks}\\n\\nClick on a track to play or send all at once!\\n\\n@PocketSound_bot`;\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: messageText,\n    parse_mode: 'HTML',\n    reply_markup: { inline_keyboard }\n  }\n}];"
      },
