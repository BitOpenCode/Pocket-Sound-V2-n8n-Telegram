      "id": "9b5cea87-b922-4ada-a19b-e4eb308dce06",
      "name": "Get playlist tracks",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "WIHxOzYOOSEjd0yr",
          "name": "Postgres account"
        }
      }
