      "parameters": {
        "jsCode": "const body = $json.body;\nconst message = body.message;\nconst text = message?.text || '';\nconst chatId = message?.chat?.id;\nconst messageId = message?.message_id;\n\nconst SUPPORT_CHAT_ID = -1003381734836;\n\n// Check if command is from support chat\nif (chatId !== SUPPORT_CHAT_ID) {\n  // Check if this is an admin command attempt\n  const isAdminCommand = text.startsWith('/reply_') || \n                         text.startsWith('/support_') || \n                         text.startsWith('/admin_true') || \n                         text.startsWith('/admin_false');\n  \n  if (isAdminCommand) {\n    // Return data for unauthorized attempt (will be handled by next node)\n    return [{\n      json: {\n        unauthorized: true,\n        from_id: message?.from?.id,\n        from_username: message?.from?.username,\n        from_first_name: message?.from?.first_name,\n        command_text: text,\n        chat_id: chatId\n      }\n    }];\n  }\n  return [];\n}\n\n// Get admin info (who sent the command)\nconst admin = message?.from;\nconst adminId = admin?.id || null;\nconst adminUsername = admin?.username || null;\nconst adminFirstName = admin?.first_name || '';\n\nlet commandType = null;\nlet targetUserId = null;\nlet replyText = null;\n\nif (text.startsWith('/reply_')) {\n  const match = text.match(/^\\/reply_(\\d+)\\s+(.+)/);\n  if (match) {\n    commandType = 'reply';\n    targetUserId = Number(match[1]);\n    replyText = match[2];\n  }\n}\nelse if (text.startsWith('/support_')) {\n  const match = text.match(/^\\/support_(\\d+)\\s+(.+)/);\n  if (match) {\n    commandType = 'support';\n    targetUserId = Number(match[1]);\n    replyText = match[2];\n  }\n}\nelse if (text.startsWith('/admin_true')) {\n  const match = text.match(/^\\/admin_true\\s+(\\d+)/);\n  if (match) {\n    commandType = 'admin_true';\n    targetUserId = Number(match[1]);\n  }\n}\nelse if (text.startsWith('/admin_false')) {\n  const match = text.match(/^\\/admin_false\\s+(\\d+)/);\n  if (match) {\n    commandType = 'admin_false';\n    targetUserId = Number(match[1]);\n  }\n}\n\nreturn [{\n  json: {\n    command_type: commandType,\n    target_user_id: targetUserId,\n    reply_text: replyText,\n    admin_chat_id: chatId,\n    admin_message_id: messageId,\n    admin_id: adminId,\n    admin_username: adminUsername,\n    admin_first_name: adminFirstName,\n    unauthorized: false\n  }\n}];"
      },
