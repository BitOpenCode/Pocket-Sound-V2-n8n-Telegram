    {
      "parameters": {
        "jsCode": "const deezerData = $input.first().json;\nconst tracks = deezerData.data || [];\nconst total = deezerData.total || 0;\n\nif (!tracks || tracks.length === 0) {\n  const chatId = $('Parse dzmore callback').item.json.chat_id;\n  const replyToMessageId = $('Parse dzmore callback').item.json.message_id;\n  const query = $('Parse dzmore callback').item.json.query;\n  \n  return [{\n    json: {\n      chat_id: chatId,\n      reply_to_message_id: replyToMessageId,\n      text: `❌ Nothing found: <b>${query}</b>\\n\\n💡 Try:\\n• Artist name only\\n• Song title only\\n• Different spelling`,\n      parse_mode: 'HTML',\n      send_as_text: true \n    }\n  }];\n}\n\nconst chatId = $('Parse dzmore callback').item.json.chat_id;\nconst replyToMessageId = $('Parse dzmore callback').item.json.message_id;\nconst query = $('Parse dzmore callback').item.json.query;\nconst offset = $('Parse dzmore callback').item.json.offset;\n\nconst photo = tracks[0]?.album?.cover_big\n  || tracks[0]?.album?.cover_medium\n  || '';\n\nconst inline_keyboard = tracks.map(track => ([\n  {\n    text: `🎵 ${track.title} — ${track.artist.name}`,\n    callback_data: `dz|${track.id}`\n  }\n]));\n\n// Кнопка More на основе РЕАЛЬНОГО количества полученных треков\nif (offset + tracks.length < total) {\n  let moreText = 'More…';\n  \n  // Показываем цифры только если получено достаточно треков (5+)\n  if (tracks.length >= 5) {\n    moreText = `More… (${offset + tracks.length}/${total})`;\n  }\n  \n  inline_keyboard.push([\n    {\n      text: moreText,\n      callback_data: `dzmore|${query}|${offset + tracks.length}`\n    }\n  ]);\n}\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    reply_to_message_id: replyToMessageId,\n    photo: photo,\n    caption: `🔍 Результаты по запросу: <b>${query}</b>`,\n    parse_mode: 'HTML',\n    reply_markup: { inline_keyboard }\n  }\n}];"
      },
