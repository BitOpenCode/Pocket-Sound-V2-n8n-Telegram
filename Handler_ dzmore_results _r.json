      "parameters": {
        "jsCode": "const callbackData = $('Parse dzmore callback').item.json.callback_data;\nconst parts = callbackData.split('|');\nlet query = parts[1] || '';\n\nquery = query\n  .replace(/[^\\w\\s\\u0400-\\u04FF-]/gi, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst offset = parts[2] || '0';\n\nreturn [{\n  json: {\n    query: query,\n    offset: Number(offset)\n  }\n}];"
      },
