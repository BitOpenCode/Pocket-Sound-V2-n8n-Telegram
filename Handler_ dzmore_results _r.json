        "jsCode": "const body = $json.body;\nconst callback = body.callback_query;\nconst message = callback.message;\nconst chatId = message.chat.id;\nconst messageId = message.message_id;\nconst from = callback.from;\nconst username = from.username || null;\nconst firstName = from.first_name || '';\nconst lastName = from.last_name || '';\nconst isPremium = from.is_premium || false;\nconst languageCode = from.language_code || 'en';\nconst callbackData = callback.data || '';\n\nconst parts = callbackData.split('|');\nconst action = parts[0];\nconst query = parts[1] || '';\nconst offsetRaw = parts[2] || '0';\nconst offset = parseInt(offsetRaw, 10);\n\nif (action !== 'dzmore') {\n  throw new Error('Invalid callback data for dzmore_results');\n}\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    message_id: messageId,\n    username: username,\n    first_name: firstName,\n    last_name: lastName,\n    is_premium: isPremium,\n    language_code: languageCode,\n    callback_data: callbackData,\n    query: query,\n    offset: offset\n  }\n}];"
      },
