    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*)::INTEGER AS track_exists\nFROM pocketsound_playlist_tracks\nWHERE playlist_id = {{ $('Parse Callback').first().json.playlist_id }}\n  AND file_id = {{ $('Parse Callback').first().json.file_id }};",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
