    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH playlist_check AS (\n  SELECT id, name, user_id, created_at\n  FROM pocketsound_playlists\n  WHERE id = {{ $('Parse Callback').first().json.playlist_id }}\n    AND user_id = {{ $('Parse Callback').first().json.user_id }}\n),\n\ntrack_count AS (\n  SELECT COUNT(*)::INTEGER AS total_tracks\n  FROM pocketsound_playlist_tracks\n  WHERE playlist_id = {{ $('Parse Callback').first().json.playlist_id }}\n),\n\ntrack_exists_check AS (\n  SELECT COUNT(*)::INTEGER AS track_exists\n  FROM pocketsound_playlist_tracks\n  WHERE playlist_id = {{ $('Parse Callback').first().json.playlist_id }}\n    AND file_id = {{ $('Parse Callback').first().json.file_id }}\n)\n\nSELECT \n  (SELECT EXISTS(SELECT 1 FROM playlist_check)) AS playlist_exists,\n  (SELECT name FROM playlist_check LIMIT 1) AS playlist_name,\n  (SELECT total_tracks FROM track_count) AS total_tracks,\n  (SELECT track_exists FROM track_exists_check) AS track_exists,\n\n  (SELECT json_agg(json_build_object('id', id, 'name', name, 'created_at', created_at))\n   FROM pocketsound_playlists\n   WHERE user_id = {{ $('Parse Callback').first().json.user_id }}\n  ) AS user_playlists;",
        "options": {}
      },
