      "parameters": {
        "jsCode": "const body = $json.body;\nconst callback = body.callback_query;\nconst message = callback.message;\nconst chatId = message.chat.id;\nconst messageId = message.message_id;\nconst username = message.chat.username || null;\nconst firstName = message.chat.first_name || '';\nconst lastName = message.chat.last_name || '';\nconst isPremium = callback.from?.is_premium || false;\nconst languageCode = callback.from?.language_code || 'en';\nconst callbackData = callback.data || '';\n\n// Parse callback data\nlet action = null;\nlet param1 = null;\nlet param2 = null;\n\nconst parts = callbackData.split('|');\naction = parts[0];\nparam1 = parts[1] || null;\nparam2 = parts[2] || null;\n\n// Determine handler type\nlet handlerType = 'unknown';\n\nif (action === 'get') {\n  handlerType = 'get_file';\n} else if (action === 'dz') {\n  handlerType = 'download_track';\n} else if (action === 'add_to_playlist') {\n  handlerType = 'add_to_playlist';\n} else if (action === 'playlist_view') {\n  handlerType = 'playlist_view';\n} else if (action === 'playlist_send_all') {\n  handlerType = 'playlist_send_all';\n} else if (action === 'more') {\n  handlerType = 'more_results';\n} else if (action === 'dzmore') {\n  handlerType = 'dzmore_results';\n} else if (action === 'playlist_add') {\n  handlerType = 'playlist_add';\n}\n\nreturn [{\n  json: {\n    handler_type: handlerType,\n    chat_id: chatId,\n    message_id: messageId,\n    username: username,\n    first_name: firstName,\n    last_name: lastName,\n    is_premium: isPremium,\n    language_code: languageCode,\n    callback_data: callbackData,\n    action: action,\n    param1: param1,\n    param2: param2\n  }\n}];"
      },
